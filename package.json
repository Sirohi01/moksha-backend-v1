{
  "name": "moksha-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Moksha Sewa - free cremation-assistance NGO platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "seed:permissions": "tsx src/scripts/seedPermissions.ts",
    "seed:organisations": "tsx src/scripts/seedOrganisations.ts",
    "seed:projects": "tsx src/scripts/seedProjects.ts",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:access-grants": "tsx src/scripts/seedAccessGrants.ts",
    "seed:notifications": "tsx src/scripts/seedNotificationTemplates.ts",
    "seed:landing": "tsx src/scripts/seedLandingPage.ts",
    "seed": "tsx src/scripts/seedAll.ts",
    "seed:demo": "tsx src/scripts/seedDemoData.ts",
    "seed:demo:clean": "tsx src/scripts/deleteDemoData.ts",
    "geocode:backfill": "tsx src/scripts/backfillGeocoding.ts",
    "migrate:inventory:namogange": "tsx migration-tools/namogange-inventory.ts",
    "migrate:inventory:volunteers": "tsx migration-tools/namogange-volunteers-inventory.ts",
    "migrate:inventory:arogya": "tsx migration-tools/arogya-inventory.ts",
    "migrate:inventory:ags": "tsx migration-tools/namogange-ags-inventory.ts",
    "migrate:dryrun:namo-cms": "tsx migration-tools/namogange-cms-dryrun.ts",
    "migrate:dryrun:arogya-cms": "tsx migration-tools/arogya-cms-dryrun.ts",
    "migrate:import:arogya-cms": "tsx migration-tools/arogya-cms-import.ts",
    "migrate:import:namo-cms": "tsx migration-tools/namogange-cms-import.ts",
    "migrate:import:arogya-lookups": "tsx migration-tools/arogya-lookups-import.ts",
    "test": "jest"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "argon2": "^0.45.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.3",
    "@types/nodemailer": "^6.4.16",
    "mongodb-memory-server": "^11.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
