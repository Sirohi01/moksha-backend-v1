# --- Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000
ADMIN_CLIENT_URL=http://localhost:3001
# Number of reverse-proxy hops in front of this server in production (e.g. 1 behind a single
# Nginx/load balancer). Keep at 0 for local dev with no proxy. See env.ts for why this matters.
TRUST_PROXY=1

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/moksha_sewa
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# --- OTP ---
# console = logs OTP to server console (use for local dev, no SMS/WhatsApp cost)
# msg91   = sends real SMS via MSG91
# aisensy = sends real WhatsApp OTP via AiSensy (requires an approved OTP template/campaign)
OTP_PROVIDER=console
OTP_EXPIRY_MINUTES=5
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
AISENSY_API_KEY=
AISENSY_CAMPAIGN_OTP=

# WhatsApp number that receives admin-facing notifications (country code, no '+')
ADMIN_WHATSAPP_NUMBER=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Moksha Sewa
SMTP_FROM_EMAIL=no-reply@mokshasewa.com
ADMIN_NOTIFICATION_EMAIL=chudharyaman1920@gmail.com
NAMOGANGE_SMTP_HOST=
NAMOGANGE_SMTP_PORT=587
NAMOGANGE_SMTP_SECURE=false
NAMOGANGE_SMTP_USER=
NAMOGANGE_SMTP_PASS=
NAMOGANGE_SMTP_FROM_NAME=Namo Gange
NAMOGANGE_SMTP_FROM_EMAIL=
AROGYA_SMTP_HOST=
AROGYA_SMTP_PORT=587
AROGYA_SMTP_SECURE=false
AROGYA_SMTP_USER=
AROGYA_SMTP_PASS=
AROGYA_SMTP_FROM_NAME=Arogya
AROGYA_SMTP_FROM_EMAIL=

# Organisation-specific OTP credentials; no organisation falls back to Moksha's keys.
NAMOGANGE_MSG91_AUTH_KEY=
NAMOGANGE_MSG91_TEMPLATE_ID=
NAMOGANGE_MSG91_SENDER_ID=
NAMOGANGE_AISENSY_API_KEY=
NAMOGANGE_AISENSY_CAMPAIGN_OTP=
AROGYA_MSG91_AUTH_KEY=
AROGYA_MSG91_TEMPLATE_ID=
AROGYA_MSG91_SENDER_ID=
AROGYA_AISENSY_API_KEY=
AROGYA_AISENSY_CAMPAIGN_OTP=

# --- Cloudinary (media uploads) ---
# Existing unprefixed variables belong to Moksha only. There is deliberately no cross-org fallback.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NAMOGANGE_CLOUDINARY_CLOUD_NAME=
NAMOGANGE_CLOUDINARY_API_KEY=
NAMOGANGE_CLOUDINARY_API_SECRET=
AROGYA_CLOUDINARY_CLOUD_NAME=
AROGYA_CLOUDINARY_API_KEY=
AROGYA_CLOUDINARY_API_SECRET=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NAMOGANGE_RAZORPAY_KEY_ID=
NAMOGANGE_RAZORPAY_KEY_SECRET=
NAMOGANGE_RAZORPAY_WEBHOOK_SECRET=
AROGYA_RAZORPAY_KEY_ID=
AROGYA_RAZORPAY_KEY_SECRET=
AROGYA_RAZORPAY_WEBHOOK_SECRET=
ENCRYPTION_KEY=
EXPOSE_DECRYPTED_DATA=false
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@mokshasewa.com
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_PASSWORD=12345678
