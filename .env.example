# --- Server ---
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000
ADMIN_CLIENT_URL=http://localhost:3001
# Number of reverse-proxy hops in front of this server in production (e.g. 1 behind a single
# Nginx/load balancer). Keep at 0 for local dev with no proxy. See env.ts for why this matters.
TRUST_PROXY=1

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/moksha_sewa

# --- JWT (access tokens are RS256; refresh tokens are opaque, server-side revocable sessions —
# see session.service.ts, no secret needed since they're never verified by signature, only by
# looking up their hash in the refreshTokens collection) ---
# Base64-encoded PEM keypair. Generate with:
#   node -e "const c=require('crypto');const{privateKey,publicKey}=c.generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('JWT_ACCESS_PRIVATE_KEY='+Buffer.from(privateKey).toString('base64'));console.log('JWT_ACCESS_PUBLIC_KEY='+Buffer.from(publicKey).toString('base64'))"
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# --- OTP ---
# console = logs OTP to server console (use for local dev, no SMS/WhatsApp cost)
# msg91   = sends real SMS via MSG91
# aisensy = sends real WhatsApp OTP via AiSensy (requires an approved OTP template/campaign)
OTP_PROVIDER=console
OTP_EXPIRY_MINUTES=5
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
AISENSY_API_KEY=
AISENSY_CAMPAIGN_OTP=

# WhatsApp number that receives admin-facing notifications (country code, no '+')
ADMIN_WHATSAPP_NUMBER=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Moksha Sewa
SMTP_FROM_EMAIL=no-reply@mokshasewa.com
ADMIN_NOTIFICATION_EMAIL=chudharyaman1920@gmail.com

# --- Cloudinary (media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Live admin dashboard integrations ---
WEBSITE_URL=https://mokshasewa.org
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
SEARCH_CONSOLE_SITE_URL=https://mokshasewa.org/
PAGESPEED_API_KEY=

# --- SEO audit platform ---
# Gemini powers the explanation/recommendation layer only. Without it the crawler, rules
# engine and every dashboard metric still work; AI panels report "not configured".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Comma-separated recipients for SEO alert emails. Falls back to ADMIN_NOTIFICATION_EMAIL.
SEO_ALERT_EMAILS=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay dashboard's Webhooks setup (Settings > Webhooks) — a different secret than
# RAZORPAY_KEY_SECRET above. Required for POST /donations/webhook/razorpay to verify events.
RAZORPAY_WEBHOOK_SECRET=

# --- Field-level encryption (PII: addresses, donor phone/email/PAN) ---
# Required. Base64 string that decodes to exactly 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse this value for anything else (e.g. a JWT secret) — key separation matters even
# when both happen to be 32 random bytes. Never commit the real value.
ENCRYPTION_KEY=
# Developer/ops toggle: false (default) = admin APIs return encrypted ciphertext for sensitive
# fields. true = admin APIs decrypt them transparently. Does not affect a user's view of their
# own data (e.g. a donor's own profile is always shown decrypted to them).
EXPOSE_DECRYPTED_DATA=false

SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@mokshasewa.com
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_PASSWORD=12345678
